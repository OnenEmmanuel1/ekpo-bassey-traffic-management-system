<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error | JunctionAI</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/itcs-variables.css">
    <link rel="stylesheet" href="/css/itcs-base.css">
    <link rel="stylesheet" href="/css/itcs-components.css">
</head>
<body style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background-color: var(--itcs-bg-main); padding: var(--itcs-space-4);">
    <div class="itcs-card" style="max-width: 460px; width: 100%; text-align: center; padding: var(--itcs-space-8); box-shadow: var(--itcs-shadow-elevated);">
        <div style="width: 48px; height: 48px; border-radius: 50%; background-color: var(--itcs-color-red-bg); border: 1px solid var(--itcs-color-red-border); color: var(--itcs-color-emergency); display: inline-flex; align-items: center; justify-content: center; margin-bottom: var(--itcs-space-4);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
        <h1 style="font-size: var(--itcs-text-xl); font-weight: 800; color: var(--itcs-text-primary); margin-bottom: var(--itcs-space-2);">
            <%= typeof message !== 'undefined' ? message : 'System Exception' %>
        </h1>
        <p style="font-size: var(--itcs-text-sm); color: var(--itcs-text-secondary); margin-bottom: var(--itcs-space-6);">
            An unexpected error occurred during intersection request execution.
        </p>

        <% if (typeof error !== 'undefined' && error && error.stack) { %>
            <div style="background-color: var(--itcs-bg-main); border: 1px solid var(--itcs-border); border-radius: var(--itcs-radius-md); padding: var(--itcs-space-3); font-family: var(--itcs-font-mono); font-size: 11px; text-align: left; color: var(--itcs-color-emergency); overflow-x: auto; margin-bottom: var(--itcs-space-6);">
                <%= error.stack %>
            </div>
        <% } %>

        <a href="/dashboard" class="itcs-btn itcs-btn-primary" style="width: 100%;">
            &larr; Return to Control Dashboard
        </a>
    </div>
</body>
</html>
