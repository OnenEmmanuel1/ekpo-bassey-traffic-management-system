<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="itcs-main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="itcs-page-content">
        <div class="itcs-page-header">
            <div>
                <h1 class="itcs-page-title">Pedestrian Crossing Safety Console</h1>
                <p class="itcs-page-subtitle">
                    Dedicated all-red vehicle hold & safe crosswalk phase coordination for Ekpo-Abasi Junction
                </p>
            </div>
            <div>
                <button class="itcs-btn itcs-btn-info" onclick="window.itcsControls.requestPedestrianCrossing()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"></circle><path d="m9 20 3-6 3 6"></path><path d="m6 8 6 2 6-2"></path><path d="M12 10v4"></path></svg>
                    <span>Push-Button Crossing Request</span>
                </button>
            </div>
        </div>

        <!-- Safety Status Cards -->
        <div class="itcs-grid itcs-grid-cols-3" style="margin-bottom: var(--itcs-space-5);">
            <div class="itcs-stat-card-kemetra">
                <div class="itcs-stat-icon-wrap itcs-stat-icon-cyan">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2"></circle><path d="m9 20 3-6 3 6"></path><path d="m6 8 6 2 6-2"></path><path d="M12 10v4"></path></svg>
                </div>
                <div class="itcs-stat-body">
                    <div class="itcs-stat-label-kemetra">Crosswalk Status</div>
                    <div class="itcs-stat-value-kemetra" style="font-size: var(--itcs-text-base);">
                        <%= state.pedestrianState.isActive ? 'WALK ACTIVE' : (state.pedestrianState.isRequested ? 'IN QUEUE' : 'STANDBY') %>
                    </div>
                    <div class="itcs-stat-sub-kemetra"><%= state.pedestrianState.isActive ? 'Vehicles held on ALL-RED' : 'Monitoring crosswalk demands' %></div>
                </div>
            </div>

            <div class="itcs-stat-card-kemetra">
                <div class="itcs-stat-icon-wrap itcs-stat-icon-blue">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div class="itcs-stat-body">
                    <div class="itcs-stat-label-kemetra">Bounded Wait Limit</div>
                    <div class="itcs-stat-value-kemetra"><%= state.config.pedestrian_max_wait_seconds %>s</div>
                    <div class="itcs-stat-sub-kemetra">Maximum queue delay before insertion</div>
                </div>
            </div>

            <div class="itcs-stat-card-kemetra">
                <div class="itcs-stat-icon-wrap itcs-stat-icon-green">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <div class="itcs-stat-body">
                    <div class="itcs-stat-label-kemetra">Total Pedestrian Waves</div>
                    <div class="itcs-stat-value-kemetra"><%= state.metrics.totalPedestrianPhases %></div>
                    <div class="itcs-stat-sub-kemetra">Safe crossing phases executed</div>
                </div>
            </div>
        </div>

        <!-- Pedestrian Crossing Log -->
        <div class="itcs-card">
            <div class="itcs-card-header">
                <div class="itcs-card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span>Pedestrian Crossing Activation History</span>
                </div>
                <a href="/api/reports/export/csv?type=pedestrian" class="itcs-btn itcs-btn-secondary itcs-btn-sm">
                    Export Pedestrian CSV
                </a>
            </div>

            <div class="itcs-table-container">
                <table class="itcs-table">
                    <thead>
                        <tr>
                            <th>Phase ID</th>
                            <th>Requested At</th>
                            <th>Phase Duration</th>
                            <th>Status</th>
                            <th>Context & Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (events && events.length > 0) { %>
                            <% events.forEach(p => { %>
                                <tr>
                                    <td><span class="itcs-badge itcs-badge-cyan">#PED-<%= p.id %></span></td>
                                    <td style="color: var(--itcs-text-secondary); font-family: var(--itcs-font-mono);">
                                        <%= new Date(p.requested_at).toLocaleString() %>
                                    </td>
                                    <td><strong><%= p.duration_seconds || 15 %>s</strong></td>
                                    <td><span class="itcs-badge itcs-badge-green">COMPLETED</span></td>
                                    <td style="color: var(--itcs-text-muted); font-size: var(--itcs-text-xs);"><%= p.notes %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; color: var(--itcs-text-muted); padding: var(--itcs-space-6);">
                                    No pedestrian events logged yet. Push the button above to request a crossing phase.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

<%- include('../partials/footer') %>
