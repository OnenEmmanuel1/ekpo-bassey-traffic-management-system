<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Sign In | JunctionAI' %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/itcs-variables.css">
    <link rel="stylesheet" href="/css/itcs-base.css">
    <link rel="stylesheet" href="/css/itcs-components.css">
    <style>
        .itcs-login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: var(--itcs-bg-main);
            padding: var(--itcs-space-4);
        }
        .itcs-login-card {
            width: 100%;
            max-width: 420px;
            background-color: #ffffff;
            border: 1px solid var(--itcs-border);
            border-radius: var(--itcs-radius-xl);
            padding: var(--itcs-space-8);
            box-shadow: var(--itcs-shadow-elevated);
        }
        .itcs-login-header {
            text-align: center;
            margin-bottom: var(--itcs-space-6);
        }
        .itcs-login-icon {
            width: 44px;
            height: 44px;
            background-color: var(--itcs-color-primary);
            color: #ffffff;
            font-size: var(--itcs-text-xl);
            font-weight: 800;
            border-radius: var(--itcs-radius-md);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: var(--itcs-space-3);
        }
        .itcs-creds-box {
            background-color: var(--itcs-bg-main);
            border: 1px solid var(--itcs-border);
            border-radius: var(--itcs-radius-md);
            padding: 12px 14px;
            margin-top: var(--itcs-space-5);
            font-size: var(--itcs-text-xs);
            color: var(--itcs-text-secondary);
        }
        .itcs-creds-row {
            display: flex;
            justify-content: space-between;
            margin-top: 4px;
        }
        .itcs-creds-val {
            font-family: var(--itcs-font-mono);
            color: var(--itcs-text-primary);
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="itcs-login-container">
        <div class="itcs-login-card">
            <div class="itcs-login-header">
                <div class="itcs-login-icon">J</div>
                <h1 style="font-size: var(--itcs-text-xl); font-weight: 800; color: var(--itcs-text-primary); letter-spacing: -0.02em;">JunctionAI</h1>
                <p style="font-size: var(--itcs-text-xs); color: var(--itcs-text-secondary); margin-top: 4px;">
                    Intelligent Traffic Control System<br>
                    <strong>Ekpo-Abasi Junction, Calabar South LGA</strong>
                </p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="itcs-alert itcs-alert-danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="itcs-alert itcs-alert-success">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <form action="/login" method="POST">
                <div class="itcs-form-group">
                    <label class="itcs-form-label" for="email">Administrator Email</label>
                    <input type="email" id="email" name="email" class="itcs-form-input" required value="<%= typeof defaultEmail !== 'undefined' ? defaultEmail : 'admin@junctionai.cr.gov.ng' %>" placeholder="admin@junctionai.cr.gov.ng">
                </div>

                <div class="itcs-form-group">
                    <label class="itcs-form-label" for="password">Password</label>
                    <input type="password" id="password" name="password" class="itcs-form-input" required value="passsword123" placeholder="••••••••••••">
                </div>

                <button type="submit" class="itcs-btn itcs-btn-primary" style="width: 100%; margin-top: var(--itcs-space-3); padding: 10px;">
                    Authenticate to Control Room &rarr;
                </button>
            </form>

            <div class="itcs-creds-box">
                <div style="font-weight: 700; color: var(--itcs-text-primary); margin-bottom: 4px;">Default Test Credentials:</div>
                <div class="itcs-creds-row">
                    <span>Email:</span>
                    <span class="itcs-creds-val">admin@junctionai.cr.gov.ng</span>
                </div>
                <div class="itcs-creds-row">
                    <span>Password:</span>
                    <span class="itcs-creds-val">passsword123</span>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
