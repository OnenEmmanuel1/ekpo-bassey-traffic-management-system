<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="itcs-main-wrapper">
    <%- include('../partials/navbar') %>

    <main class="itcs-page-content">
        <div class="itcs-page-header">
            <div>
                <h1 class="itcs-page-title">Events & Emergency Priority Dispatch</h1>
                <p class="itcs-page-subtitle">
                    Priority corridor clearance for emergency responders & comprehensive incident audit records
                </p>
            </div>
            <div>
                <button class="itcs-btn itcs-btn-danger" onclick="window.itcsControls.openModal('itcs-emergency-modal')">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <span>New Dispatch Override</span>
                </button>
            </div>
        </div>

        <!-- Preemption Status & Dispatch Terminal Grid -->
        <div class="itcs-grid itcs-grid-cols-12" style="margin-bottom: var(--itcs-space-5);">
            <!-- Status Card (5 cols) -->
            <div class="itcs-col-span-5">
                <div class="itcs-card" style="height: 100%;">
                    <div class="itcs-card-header">
                        <div class="itcs-card-title">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"></circle><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path></svg>
                            <span>Active Priority Status</span>
                        </div>
                        <span class="itcs-badge <%= state.emergencyState.isActive ? 'itcs-badge-red' : 'itcs-badge-green' %>">
                            <%= state.emergencyState.isActive ? 'OVERRIDE ENGAGED' : 'STANDBY (MONITORING)' %>
                        </span>
                    </div>

                    <% if (state.emergencyState.isActive) { %>
                        <div style="background-color: var(--itcs-color-emergency-bg); border: 1px solid var(--itcs-color-red-border); border-radius: var(--itcs-radius-md); padding: var(--itcs-space-4); margin-bottom: var(--itcs-space-4);">
                            <div style="font-size: var(--itcs-text-sm); font-weight: 700; color: var(--itcs-color-red-dark); margin-bottom: 6px; display: flex; align-items: center; gap: 6px;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                <span>ACTIVE EMERGENCY CORRIDOR CLEARANCE</span>
                            </div>
                            <div style="font-size: var(--itcs-text-xs); color: var(--itcs-text-secondary); line-height: 1.5;">
                                <div>Trigger Source: <strong><%= state.emergencyState.triggeredBy %></strong></div>
                                <div>Hold Remaining: <strong><%= state.emergencyState.holdSecondsRemaining %> seconds</strong></div>
                                <div style="margin-top: 4px;">Notes: <%= state.emergencyState.notes %></div>
                            </div>
                        </div>

                        <button class="itcs-btn itcs-btn-secondary" style="width: 100%;" onclick="window.itcsControls.clearEmergency()">
                            Release Preemption Override &rarr;
                        </button>
                    <% } else { %>
                        <p style="font-size: var(--itcs-text-sm); color: var(--itcs-text-secondary); margin-bottom: var(--itcs-space-4); line-height: 1.5;">
                            No priority override is currently active. The simulated sensor stream continuously monitors for optical/acoustic transponder flags from ambulances and emergency convoys.
                        </p>

                        <div style="background-color: var(--itcs-bg-card-subtle); border: 1px solid var(--itcs-border-subtle); border-radius: var(--itcs-radius-md); padding: var(--itcs-space-3); font-size: var(--itcs-text-xs); color: var(--itcs-text-muted);">
                            <strong>Safety Buffer:</strong> Conflicting phases receive an immediate 3s yellow clearance and 1s all-red buffer before forcing the emergency lane green.
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Fast Dispatch Terminal (7 cols) -->
            <div class="itcs-col-span-7">
                <div class="itcs-card">
                    <div class="itcs-card-header">
                        <div class="itcs-card-title">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                            <span>Quick Emergency Route Trigger</span>
                        </div>
                        <span class="itcs-badge itcs-badge-blue">Authorized Admin Override</span>
                    </div>

                    <div class="itcs-grid itcs-grid-cols-2" style="gap: var(--itcs-space-3);">
                        <% state.lanes.forEach(l => { %>
                            <div style="background-color: var(--itcs-bg-card-subtle); border: 1px solid var(--itcs-border-subtle); border-radius: var(--itcs-radius-md); padding: var(--itcs-space-3);">
                                <div style="font-weight: 700; font-size: var(--itcs-text-sm); margin-bottom: 2px;"><%= l.name %></div>
                                <div style="font-size: 11px; color: var(--itcs-text-muted); margin-bottom: 8px;"><%= l.direction %> &bull; <%= l.approachDescription %></div>
                                <button class="itcs-btn itcs-btn-danger itcs-btn-sm" style="width: 100%;"
                                        onclick="window.itcsControls.triggerEmergency(<%= l.id %>, 'Quick Dispatch Command', 'Manual corridor emergency clearance')">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                    <span>Preempt Lane <%= l.id %> &rarr;</span>
                                </button>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Incident Logs Table -->
        <div class="itcs-card">
            <div class="itcs-card-header">
                <div class="itcs-card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    <span>Emergency Preemption Incident Audit Log</span>
                </div>
                <a href="/api/reports/export/csv?type=preemption" class="itcs-btn itcs-btn-secondary itcs-btn-sm">
                    Export Preemption CSV
                </a>
            </div>

            <div class="itcs-table-container">
                <table class="itcs-table">
                    <thead>
                        <tr>
                            <th>Incident ID</th>
                            <th>Target Corridor</th>
                            <th>Triggering Authority / Detection</th>
                            <th>Status</th>
                            <th>Timestamp</th>
                            <th>Hold Duration</th>
                            <th>Operational Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (events && events.length > 0) { %>
                            <% events.forEach(e => { %>
                                <tr>
                                    <td><span class="itcs-badge itcs-badge-purple">#PR-<%= e.id %></span></td>
                                    <td><strong><%= e.lane_name || 'All Approaches' %></strong></td>
                                    <td><%= e.triggered_by %></td>
                                    <td><span class="itcs-badge itcs-badge-green"><%= e.status %></span></td>
                                    <td style="color: var(--itcs-text-secondary); font-family: var(--itcs-font-mono);">
                                        <%= new Date(e.triggered_at).toLocaleString() %>
                                    </td>
                                    <td><strong><%= e.duration_seconds %>s</strong></td>
                                    <td style="font-size: var(--itcs-text-xs); color: var(--itcs-text-muted);"><%= e.notes %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" style="text-align: center; color: var(--itcs-text-muted); padding: var(--itcs-space-6);">
                                    No preemption events logged yet. Trigger an emergency dispatch above to record incidents.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

<%- include('../partials/footer') %>
